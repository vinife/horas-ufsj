// prisma/schema.prisma

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
  
}

datasource db {
  provider = "postgresql" // ou mysql
  
}

// Enums (Tipos fixos) facilitam muito a lógica
enum UserRole {
  STUDENT
  ADMIN
}


enum Status {
  PENDING
  APPROVED
  REJECTED
}

enum AiStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum CertificateType {
  EXTENSAO
  COMPLEMENTAR
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  image         String?
  role          UserRole 
  accessStatus  Status @default(PENDING)
  reviewedAt    DateTime?   
  createdAt     DateTime  @default(now())

  // --- PERMISSÕES GRANULARES (Válidas quando role == ADMIN) ---
  canManageComplementar Boolean @default(false)
  canManageExtensao     Boolean @default(false)
  canManageUsers        Boolean @default(false) // Pode gerir aprovações/permissões de usuários

  // Relacionamento: Um aluno tem vários certificados
  certificados  Certificate[]
}

model Certificate {
  id              String          @id @default(cuid())
  
  
  // --- DADOS OFICIAIS (O que vale para o aluno no final) ---
  title           String
  hours           Int?
  certificatetype CertificateType @default(COMPLEMENTAR)
  status          Status          @default(PENDING)
  feedback        String?

  // --- DADOS DO ARQUIVO ---
  fileUrl         String   
  fileId          String   

  // --- INTERVENÇÃO DA IA (Totalmente Isolada) ---
  aiStatus        AiStatus        @default(QUEUED)
  aiSuggestedTitle String?
  aiSuggestedHours Int?
  aiFeedback      Json?

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Conexão com o Aluno
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SystemConfig {
  id              String   @id @default("current_config")
  tunedTextModel  String?  // Ex: "tunedModels/gemini-ufsj-texto-v1"
  updatedAt       DateTime @updatedAt
}