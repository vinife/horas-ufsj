// prisma/schema.prisma

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
  
}

datasource db {
  provider = "postgresql" // ou mysql
  
}

// Enums (Tipos fixos) facilitam muito a lógica
enum UserRole {
  STUDENT
  ADMIN
}

enum AccessStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Status {
  PENDENTE
  APROVADO
  REJEITADO
}

enum CertificateType {
  EXTENSÃO
  COMPLEMENTAR
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  image         String?
  role          UserRole  @default(STUDENT) // Define quem é quem
  accessStatus  AccessStatus @default(PENDING)
  reviewedAt    DateTime?
  reviewNote    String?
  createdAt     DateTime  @default(now())

  // Relacionamento: Um aluno tem vários certificados
  certificados  Certificate[]
}

model Certificate {
  id            String   @id @default(cuid())
  title         String   // Ex: "Curso de Python"
  description   String?
  hours         Int      // Quantidade de horas solicitadas
  certificatetype          CertificateType     @default(COMPLEMENTAR)

  // Dados do Google Drive
  fileUrl       String   // O link para ver o arquivo
  fileId        String   // O ID do Google Drive (para deletar depois se precisar)

  status        Status   @default(PENDENTE)
  feedback      String?  // Motivo do indeferimento (escrito pelo admin)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Conexão com o Aluno
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
